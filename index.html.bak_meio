<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#42c9df">

<title>15 Anos da Maria</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Great+Vibes&family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

<style>

*{ margin:0; padding:0; box-sizing:border-box; }
html, body{ width:100%; height:100%; }
body{
    overflow:hidden;
    background:#dff8fa;
    font-family:"Montserrat",sans-serif;
    -webkit-tap-highlight-color:transparent;
}

#intro{
    position:fixed; inset:0; z-index:100;
    overflow:hidden; cursor:pointer; background:#59cfe1;
    transition: opacity 1.4s ease, visibility 1.4s ease;
}
#intro.hide{ opacity:0; visibility:hidden; pointer-events:none; }
#intro.diving{ pointer-events:none; opacity:0; transition: opacity 1.8s cubic-bezier(.55,0,.4,1); }

.sky{ position:absolute; inset:0; z-index:1;
    background: linear-gradient(180deg, #3dbddd 0%, #6dcfe5 27%, #a7e0e7 52%, #dcece3 68%, #f0dfb8 100%);
}
.sun{
    position:absolute; z-index:4;
    width:110px; height:110px; top:10%; right:9%;
    border-radius:50%;
    background: radial-gradient(circle, #fffef1 0%, #fff5c8 35%, #ffd86c 62%, rgba(255,215,100,.12) 74%);
    box-shadow: 0 0 35px rgba(255,237,166,.85), 0 0 120px rgba(255,228,134,.38);
}
.cloud{ position:absolute; z-index:3;
    width:170px; height:34px; border-radius:60px;
    background: rgba(255,255,255,.65); filter:blur(2.5px);
    box-shadow: 0 8px 18px rgba(120,180,205,.10);
}
.cloud::before, .cloud::after{
    content:""; position:absolute; bottom:4px; border-radius:50%;
    background:inherit; box-shadow: inset 0 -3px 6px rgba(200,225,238,.18);
}
.cloud::before{ left:12%; width:74px; height:74px; }
.cloud::after{ right:10%; width:96px; height:96px; bottom:2px; }
.cloud.one{ left:4%; top:15%; transform:scale(.85); opacity:.9; }
.cloud.two{ left:36%; top:24%; transform:scale(.55); opacity:.7; }
.cloud.three{ right:14%; top:13%; transform:scale(.7); opacity:.75; }
.cloud.four{ left:62%; top:34%; transform:scale(.38); opacity:.5; }

.horizon{
    position:absolute; z-index:8; top:50%; left:0; right:0;
    height:35px;
    background: linear-gradient(180deg, rgba(255,255,255,.85), rgba(255,255,255,0));
    filter:blur(6px);
}

.ocean{
    position:absolute; z-index:10; left:0; right:0; top:50%; bottom:0;
    overflow:hidden;
    background: linear-gradient(180deg, #a3dde5 0%, #b5e2eb 45%, #ceeaf1 100%);
}
#waterCanvas{ position:absolute; inset:0; width:100%; height:100%; display:block; }

.sand{
    position:absolute; z-index:25; left:-6%; right:-6%;
    bottom:-4%; height:32%;
    clip-path: polygon(0 14%, 10% 12.2%, 22% 13.6%, 34% 12.4%, 48% 13.8%,
        60% 12.6%, 72% 13.4%, 84% 12.2%, 94% 13.2%, 100% 12.6%,
        100% 100%, 0 100%);
    background-color:#eed9a8;
    background-image:
        linear-gradient(180deg, rgba(255,251,239,.55) 0%, rgba(255,244,220,.25) 30%, transparent 60%),
        radial-gradient(circle, rgba(255,255,255,.85) 0 1px, transparent 1.6px),
        radial-gradient(circle, rgba(176,141,84,.38) 0 1px, transparent 1.6px),
        radial-gradient(circle, rgba(163,128,72,.45) 0 1.7px, transparent 2.5px),
        linear-gradient(180deg, #fdf4dc 0%, #f5e4bb 26%, #ecd6a2 58%, #d8b981 100%);
    background-size: 100% 100%, 22px 18px, 30px 24px, 68px 60px, 100% 100%;
    background-position: 0 0, 0 0, 13px 9px, 31px 22px, 0 0;
}
.sand::before{
    content:""; position:absolute; left:0; right:0; top:0; height:38%;
    background: linear-gradient(180deg, rgba(122,92,50,.42) 0%, rgba(135,103,58,.24) 40%, rgba(150,118,70,.07) 74%, transparent 100%);
    filter:blur(1.2px); pointer-events:none;
}
.sand::after{
    content:""; position:absolute; left:0; right:0; top:0; height:44%;
    background: repeating-linear-gradient(177deg, rgba(255,255,255,.22) 0 1.5px, transparent 2px 11px);
    opacity:.55; filter:blur(2px); pointer-events:none;
}

.foam{
    position:absolute; z-index:27; left:-12%; right:-12%; top:70%; height:66px;
    pointer-events:none;
    background:
        radial-gradient(ellipse 14% 34% at 6% 48%, rgba(255,255,255,.95), transparent 72%),
        radial-gradient(ellipse 11% 28% at 17% 40%, rgba(255,255,255,.9), transparent 72%),
        radial-gradient(ellipse 13% 32% at 30% 54%, rgba(255,255,255,.95), transparent 72%),
        radial-gradient(ellipse 10% 26% at 43% 42%, rgba(255,255,255,.85), transparent 72%),
        radial-gradient(ellipse 15% 36% at 57% 52%, rgba(255,255,255,.95), transparent 72%),
        radial-gradient(ellipse 11% 28% at 70% 40%, rgba(255,255,255,.9), transparent 72%),
        radial-gradient(ellipse 14% 34% at 84% 50%, rgba(255,255,255,.95), transparent 72%),
        radial-gradient(ellipse 12% 30% at 95% 44%, rgba(255,255,255,.9), transparent 72%);
    filter:blur(3px); opacity:.8;
    animation: foamBreath 8s ease-in-out infinite;
}
@keyframes foamBreath{
    0%,100%{ transform:translateX(0) scaleY(1); opacity:.7; }
    50%{ transform:translateX(-1.4%) scaleY(1.14); opacity:.9; }
}

.shore-deco{ position:absolute; inset:0; z-index:26; pointer-events:none; }
.deco{ position:absolute; display:block; }
.deco.shell-a{ width:30px; height:30px; left:17%; bottom:7%; transform:rotate(-14deg); opacity:.95; }
.deco.shell-b{ width:22px; height:22px; right:21%; bottom:12%; transform:rotate(22deg); opacity:.85; }
.deco.star{ width:28px; height:28px; right:9%; bottom:6%; transform:rotate(-9deg); opacity:.9; }
.deco.pebble{ position:absolute; border-radius:50%;
    background: linear-gradient(145deg, #d8c39a, #b39a70);
    box-shadow: inset 0 -1px 2px rgba(120,96,58,.5), 0 1px 2px rgba(120,96,58,.28);
}
.deco.pebble.p1{ width:9px; height:7px; left:34%; bottom:9%; }
.deco.pebble.p2{ width:7px; height:6px; left:63%; bottom:15%; }
.deco.pebble.p3{ width:11px; height:8px; left:79%; bottom:8%; }

.birds{ position:absolute; inset:0; z-index:40; pointer-events:none; overflow:hidden; }
.bird{ position:absolute; width:58px; height:35px; will-change:transform; }
.bird svg{ display:block; width:100%; height:100%; overflow:visible;
    filter: drop-shadow(0 2px 3px rgba(16,74,104,.18));
}
.bird .body{ fill:rgba(255,255,255,.97); }
.bird .wing{ fill:rgba(255,255,255,.93); }
.bird .wing-l, .bird .wing-r{
    transform-box:view-box; transform-origin:50px 38px;
    animation: flapLeft .78s ease-in-out infinite;
}
.bird .wing-r{ animation-name:flapRight; }
@keyframes flapLeft{ 0%,100%{ transform:rotate(-17deg); } 50%{ transform:rotate(15deg); } }
@keyframes flapRight{ 0%,100%{ transform:rotate(17deg); } 50%{ transform:rotate(-15deg); } }
.bird.two svg .wing-l, .bird.two svg .wing-r{ animation-duration:.94s; }
.bird.three svg .wing-l, .bird.three svg .wing-r{ animation-duration:.7s; }
.bird.four svg .wing-l, .bird.four svg .wing-r{ animation-duration:1.05s; }
.bird.five svg .wing-l, .bird.five svg .wing-r{ animation-duration:.84s; }
.bird.one{ left:-70px; top:14%; animation: flyOne 14s linear infinite; }
@keyframes flyOne{
    0%{ transform:translate3d(-5vw,2vh,0) rotate(-4deg) scale(.9); }
    15%{ transform:translate3d(15vw,-3vh,0) rotate(4deg) scale(.9); }
    32%{ transform:translate3d(34vw,-6vh,0) rotate(7deg) scale(.9); }
    49%{ transform:translate3d(53vw,0vh,0) rotate(-3deg) scale(.9); }
    67%{ transform:translate3d(72vw,5vh,0) rotate(-7deg) scale(.9); }
    84%{ transform:translate3d(92vw,-2vh,0) rotate(4deg) scale(.9); }
    100%{ transform:translate3d(125vw,3vh,0) rotate(-3deg) scale(.9); }
}
.bird.two{ left:-70px; top:25%; animation: flyTwo 17s linear infinite; animation-delay:-6s; }
@keyframes flyTwo{
    0%{ transform:translate3d(-5vw,0,0) rotate(4deg) scale(.7); }
    20%{ transform:translate3d(20vw,5vh,0) rotate(-3deg) scale(.7); }
    42%{ transform:translate3d(43vw,0vh,0) rotate(-7deg) scale(.7); }
    62%{ transform:translate3d(66vw,-5vh,0) rotate(5deg) scale(.7); }
    82%{ transform:translate3d(91vw,2vh,0) rotate(2deg) scale(.7); }
    100%{ transform:translate3d(128vw,-1vh,0) rotate(-4deg) scale(.7); }
}
.bird.three{ left:-70px; top:10%; animation: flyThree 19s linear infinite; animation-delay:-10s; }
@keyframes flyThree{
    0%{ transform:translate3d(-5vw,0,0) rotate(-2deg) scale(.52); }
    23%{ transform:translate3d(23vw,-4vh,0) rotate(5deg) scale(.52); }
    45%{ transform:translate3d(47vw,3vh,0) rotate(-5deg) scale(.52); }
    70%{ transform:translate3d(77vw,-4vh,0) rotate(4deg) scale(.52); }
    100%{ transform:translate3d(130vw,2vh,0) rotate(-3deg) scale(.52); }
}
.bird.four{ left:-70px; top:36%; animation: flyTwo 20s linear infinite; animation-delay:-13s; }
.bird.five{ left:-70px; top:20%; animation: flyThree 21s linear infinite; animation-delay:-15s; }

.touch{
    position:absolute; z-index:50; left:50%; top:54%;
    transform:translate(-50%,-50%);
    display:flex; flex-direction:column; align-items:center; gap:11px;
    color:white; text-shadow: 0 2px 9px rgba(0,0,0,.25);
    pointer-events:none; transition: opacity .8s ease;
}
#intro.diving .touch{ opacity:0; }
.touch-circle{
    width:72px; height:72px;
    border: 2px solid rgba(255,255,255,.9);
    border-radius:50%;
    animation: pulse 2s ease-out infinite;
}
.touch span{ font-size:11px; font-weight:500; letter-spacing:2px; text-transform:uppercase; }
@keyframes pulse{
    0%{ transform:scale(.8); opacity:.95; }
    70%{ transform:scale(1.22); opacity:.25; }
    100%{ transform:scale(1.4); opacity:0; }
}

#scene{
    position:fixed; inset:0; z-index:110; width:100%; height:100%;
    opacity:0; pointer-events:none;
    transition: opacity 1.6s cubic-bezier(.5,0,.3,1);
}
#scene.active{ opacity:1; }

#invitation{
    position:fixed; inset:0; z-index:50;
    overflow-x:hidden; overflow-y:auto;
    padding: max(15px,env(safe-area-inset-top)) 12px max(30px,env(safe-area-inset-bottom)) 12px;
    opacity:0; visibility:hidden; transform:translateY(25px);
    transition: opacity .9s ease, transform .9s ease, visibility .9s ease;
    scrollbar-width:none;
    background: linear-gradient(180deg, #d5ecf8, #eef8fd 45%, #e3f2fa 100%);
}
#invitation::-webkit-scrollbar{ display:none; }
#invitation.open{ opacity:1; visibility:visible; transform:translateY(0); }

.wrapper{ width:min(900px,100%); margin:auto; }
.card{
    position:relative; width:100%; margin: 8px auto 30px;
    padding: 45px clamp(17px,5vw,60px) 45px;
    overflow:hidden; text-align:center; border-radius:30px;
    background: linear-gradient(150deg, #ffffff 0%, #f2fafe 45%, #e2f2fb 100%);
    box-shadow: 0 25px 70px rgba(20,80,120,.20), 0 4px 14px rgba(20,80,120,.08);
}
.card::before{
    content:""; position:absolute; inset:10px;
    border: 1px solid rgba(201,161,74,.55); border-radius:22px; pointer-events:none;
}
.card::after{
    content:""; position:absolute; inset:0;
    background:
        radial-gradient(circle at 12% 6%, rgba(255,255,255,.9), transparent 30%),
        radial-gradient(circle at 88% 92%, rgba(180,220,240,.4), transparent 34%);
    pointer-events:none; opacity:.7;
}
.corner{ position:absolute; color:#c9a14a; font-size:24px; z-index:3; }
.corner.a{ top:20px; left:24px; }
.corner.b{ top:20px; right:24px; }
.corner.c{ bottom:20px; left:24px; }
.corner.d{ bottom:20px; right:24px; }

.shell{ position:absolute; width:43px; height:43px; opacity:.85; z-index:3; }
.shell.left{ left:5%; top:195px; transform:rotate(-18deg); }
.shell.right{ right:5%; top:195px; transform:rotate(18deg); }
.shell svg{ width:100%; height:100%; }
.shell path{ fill:#eaf4fb; stroke:#c9a14a; stroke-width:2; }

.eyebrow{
    position:relative; z-index:3; margin-bottom:8px; color:#b08838;
    font-size:10px; font-weight:600; letter-spacing:4px; text-transform:uppercase;
}
.title{
    position:relative; z-index:3; color:#0e4d78;
    font-family:"Great Vibes",cursive;
    font-size: clamp(54px,11vw,100px);
    font-weight:400; line-height:.95; margin-bottom:10px;
    text-shadow: 0 2px 12px rgba(120,180,215,.25);
}
.subtitle{
    position:relative; z-index:3; margin-bottom:27px;
    color:#4c88a9; font-family:"Cormorant Garamond",serif;
    font-size:22px; font-style:italic;
}
.photo-wrap{
    position:relative; width:210px; height:210px;
    margin: 0 auto 28px; display:flex; align-items:center; justify-content:center;
    z-index:3;
}
.photo-border{
    position:absolute; inset:0; border-radius:50%;
    border: 2px solid #c9a14a;
    box-shadow: 0 0 0 5px #fff, 0 0 0 7px rgba(201,161,74,.55), 0 12px 25px rgba(20,80,120,.15);
}
.photo{
    position:relative; z-index:2; width:178px; height:178px;
    object-fit:cover; border-radius:50%; border: 4px solid white;
}

.bow{
    position:absolute;
    z-index:5;
    right:-38px;
    top:-16px;
    width:110px;
    height:96px;
    transform: rotate(14deg);
    transform-origin: 50% 40%;
    filter: drop-shadow(0 5px 7px rgba(20,60,100,.35));
    pointer-events:none;
}
.bow svg{
    display:block;
    width:100%;
    height:100%;
    overflow:visible;
}

.message{
    position:relative; z-index:3; max-width:620px; margin: 0 auto 28px;
    color:#3f6782; font-family:"Cormorant Garamond",serif;
    font-size:24px; line-height:1.4;
}
.message strong{ color:#0e4d78; font-family:"Playfair Display",serif; }
.icon{
    width:23px; height:23px; fill:none;
    stroke:#b08838; stroke-width:1.7;
    stroke-linecap:round; stroke-linejoin:round;
}
.info{
    position:relative; z-index:3; display:grid;
    grid-template-columns: repeat(3,1fr); gap:12px;
    width:100%; max-width:720px; margin: 25px auto;
}
.info-box{
    min-height:105px; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:7px; padding:12px;
    border-radius:18px;
    background: linear-gradient(145deg, #ffffff, #e6f3fb);
    border: 1px solid rgba(201,161,74,.38);
    box-shadow: 0 4px 12px rgba(30,90,130,.06);
}
.info-box small, .suggestion small{
    color:#6a93ab; font-size:9px; letter-spacing:1.5px; text-transform:uppercase;
}
.info-box strong, .suggestion strong{
    color:#0e4d78; font-family:"Playfair Display",serif; font-size:15px;
}
.divider{
    width:min(500px,80%); height:1px; margin: 28px auto;
    background: linear-gradient(90deg, transparent, #c9a14a, transparent);
}
.confirm{
    position:relative; z-index:3; max-width:600px; margin: 0 auto 22px;
    padding:17px; border-radius:16px;
    background: linear-gradient(145deg, #e6f4fc, #d5ebf7);
    border: 1px solid rgba(201,161,74,.45);
    box-shadow: 0 4px 12px rgba(30,90,130,.06);
}
.confirm strong{
    display:block; color:#0e4d78;
    font-family:"Playfair Display",serif; font-size:15px; margin-bottom:5px;
}
.confirm span{ color:#5b87a1; font-size:13px; }
.notice{
    position:relative; z-index:3; max-width:720px; margin: 20px auto;
    padding: 19px 20px; text-align:left;
    border-left: 3px solid #c9a14a; border-radius: 0 15px 15px 0;
    background: linear-gradient(90deg, rgba(213,235,247,.85), rgba(230,244,252,.55));
}
.notice-title{
    display:flex; align-items:center; gap:8px; margin-bottom:7px;
    color:#a07726; font-family:"Playfair Display",serif; font-size:15px;
}
.notice-icon{
    width:20px; height:20px; fill:none;
    stroke:#b08838; stroke-width:1.7;
    stroke-linecap:round; stroke-linejoin:round;
}
.notice p{
    color:#3f6782; font-family:"Cormorant Garamond",serif;
    font-size:19px; line-height:1.45;
}
.suggest-title{
    position:relative; z-index:3; margin: 30px 0 18px;
    color:#0e4d78; font-family:"Great Vibes",cursive;
    font-size:43px; font-weight:400;
}
.suggestions{
    position:relative; z-index:3; width:100%; max-width:760px;
    margin:auto; display:grid; grid-template-columns: repeat(3,1fr); gap:12px;
}
.suggestion{
    min-height:105px; padding:12px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:7px; border-radius:17px;
    background: linear-gradient(145deg, #ffffff, #ecf6fc);
    border: 1px solid rgba(201,161,74,.35);
    box-shadow: 0 3px 10px rgba(30,90,130,.05);
}
.final{
    position:relative; z-index:3; max-width:620px; margin: 25px auto 0;
    color:#5b87a1; font-family:"Cormorant Garamond",serif;
    font-size:19px; font-style:italic; line-height:1.4;
}

@media(max-width:700px){
    .sun{ width:82px; height:82px; }
    .cloud.one{ transform:scale(.55); }
    .cloud.two{ transform:scale(.4); }
    .cloud.three{ transform:scale(.5); }
    .cloud.four{ transform:scale(.3); }
    .title{ font-size:60px; }
    .card{ padding: 38px 15px 40px; border-radius:25px; }
    .photo-wrap{ width:195px; height:195px; }
    .photo{ width:165px; height:165px; }
    .bow{ width:100px; height:88px; right:-34px; top:-14px; }
    .info{ grid-template-columns:1fr; }
    .info-box{ min-height:82px; }
    .message{ font-size:21px; }
    .suggestions{ grid-template-columns: repeat(2,1fr); }
    .suggestion:last-child{ grid-column: 1 / -1; }
}
@media(max-width:390px){
    .title{ font-size:53px; }
    .photo-wrap{ width:180px; height:180px; }
    .photo{ width:151px; height:151px; }
    .bow{ width:92px; height:82px; right:-30px; top:-12px; }
    .message{ font-size:20px; }
}
@media(prefers-reduced-motion:reduce){
    .bird .wing-l, .bird .wing-r,
    .touch-circle, .foam{ animation:none; }
}

</style>
</head>

<body>

<section id="intro">
    <div class="sky"></div>
    <div class="sun"></div>
    <div class="cloud one"></div>
    <div class="cloud two"></div>
    <div class="cloud three"></div>
    <div class="cloud four"></div>
    <div class="horizon"></div>
    <div class="ocean">
        <canvas id="waterCanvas"></canvas>
    </div>
    <div class="foam"></div>
    <div class="sand"></div>
    <div class="shore-deco">
        <svg class="deco shell-a" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M20 35 C9 32 4 23 6 15 C8 7 14 3 20 3 C26 3 32 7 34 15 C36 23 31 32 20 35 Z"
                fill="#f8efd6" stroke="#d9bd82" stroke-width="1.3"/>
            <path d="M20 34V4 M20 34L11 7 M20 34L29 7 M20 34L7 16 M20 34L33 16"
                fill="none" stroke="#d9bd82" stroke-width=".9" opacity=".8"/>
        </svg>
        <svg class="deco shell-b" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M20 35 C9 32 4 23 6 15 C8 7 14 3 20 3 C26 3 32 7 34 15 C36 23 31 32 20 35 Z"
                fill="#fbf3e2" stroke="#ddc491" stroke-width="1.3"/>
            <path d="M20 34V4 M20 34L11 7 M20 34L29 7 M20 34L7 16 M20 34L33 16"
                fill="none" stroke="#ddc491" stroke-width=".9" opacity=".8"/>
        </svg>
        <svg class="deco star" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M20 4 L24.6 15.4 L36.4 16.4 L27.4 24 L30.4 35.6 L20 29.2 L9.6 35.6 L12.6 24 L3.6 16.4 L15.4 15.4 Z"
                fill="#f5cfa9" stroke="#dda57e" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
        <span class="deco pebble p1"></span>
        <span class="deco pebble p2"></span>
        <span class="deco pebble p3"></span>
    </div>
    <div class="birds">
        <div class="bird one"><svg viewBox="0 0 100 60" aria-hidden="true">
            <g class="wing-l"><path class="wing" d="M50 38 C40 18 20 10 3 14 C16 25 32 35 50 41 Z"/></g>
            <g class="wing-r"><path class="wing" d="M50 38 C60 18 80 10 97 14 C84 25 68 35 50 41 Z"/></g>
            <ellipse class="body" cx="50" cy="38.5" rx="8" ry="4.8"/>
            <circle class="body" cx="57" cy="36" r="3.6"/>
        </svg></div>
        <div class="bird two"><svg viewBox="0 0 100 60" aria-hidden="true">
            <g class="wing-l"><path class="wing" d="M50 38 C40 18 20 10 3 14 C16 25 32 35 50 41 Z"/></g>
            <g class="wing-r"><path class="wing" d="M50 38 C60 18 80 10 97 14 C84 25 68 35 50 41 Z"/></g>
            <ellipse class="body" cx="50" cy="38.5" rx="8" ry="4.8"/>
            <circle class="body" cx="57" cy="36" r="3.6"/>
        </svg></div>
        <div class="bird three"><svg viewBox="0 0 100 60" aria-hidden="true">
            <g class="wing-l"><path class="wing" d="M50 38 C40 18 20 10 3 14 C16 25 32 35 50 41 Z"/></g>
            <g class="wing-r"><path class="wing" d="M50 38 C60 18 80 10 97 14 C84 25 68 35 50 41 Z"/></g>
            <ellipse class="body" cx="50" cy="38.5" rx="8" ry="4.8"/>
            <circle class="body" cx="57" cy="36" r="3.6"/>
        </svg></div>
        <div class="bird four"><svg viewBox="0 0 100 60" aria-hidden="true">
            <g class="wing-l"><path class="wing" d="M50 38 C40 18 20 10 3 14 C16 25 32 35 50 41 Z"/></g>
            <g class="wing-r"><path class="wing" d="M50 38 C60 18 80 10 97 14 C84 25 68 35 50 41 Z"/></g>
            <ellipse class="body" cx="50" cy="38.5" rx="8" ry="4.8"/>
            <circle class="body" cx="57" cy="36" r="3.6"/>
        </svg></div>
        <div class="bird five"><svg viewBox="0 0 100 60" aria-hidden="true">
            <g class="wing-l"><path class="wing" d="M50 38 C40 18 20 10 3 14 C16 25 32 35 50 41 Z"/></g>
            <g class="wing-r"><path class="wing" d="M50 38 C60 18 80 10 97 14 C84 25 68 35 50 41 Z"/></g>
